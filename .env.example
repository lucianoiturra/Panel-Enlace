# Plantilla del .env que vive en /srv/apps/compose/panel-enlace/ (chmod 600).
# La misma DB_PASSWORD la consumen panel-db, panel-mon-export y el respaldo.
DB_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://panel:replace-with-a-long-random-password@panel-db:5432/panel
# Sin estas dos la app responde 503 a todo: el guardia falla cerrado.
APP_USERNAME=replace-with-a-private-username
APP_PASSWORD=replace-with-a-long-random-password
# Larga, secreta y estable: si cambia, los PIN ya guardados quedan ilegibles.
PIN_ENCRYPTION_KEY=replace-with-a-long-random-secret
