[Unit]
Description=Avisos de salud de cabserver hacia ntfy
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/alerta-cabserver.sh
TimeoutStartSec=60

# Es un lector: consulta /api/salud y publica en ntfy. No escribe fuera de su
# propio directorio de estado, asi que no tiene por que poder hacerlo.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/alerta-cabserver
