[Unit]
Description=Parte diario de salud de cabserver hacia Telegram
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/alerta-cabserver.sh --resumen
TimeoutStartSec=60

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/alerta-cabserver
